NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://username:password@localhost:3306/sripaa"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SriPAA Growth System
# Daily missing-entry email time in the business timezone (24-hour HH:mm).
DAILY_DATA_REMINDER_TIME=20:00
BUSINESS_TIMEZONE=Asia/Kolkata
# COOKIE_SECURE defaults to false outside production and true in production.
# Production rejects COOKIE_SECURE=false; HTTPS is required for browser sessions.
COOKIE_SECURE=false
# Defaults to lax in development and none in production. For separate-site
# frontend/API deployments, production requires HTTPS and secure cookies.
# Override only when frontend and API are on the same site: COOKIE_SAME_SITE=lax
LOG_LEVEL=info

# Development-only demo account passwords (minimum 12 characters).
# These are required only by `npm run db:seed`; seeding is blocked in production.
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_DIRECTOR_PASSWORD=
SEED_FINANCE_PASSWORD=
SEED_DATA_ENTRY_PASSWORD=
SEED_AUDITOR_PASSWORD=
