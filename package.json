{
    "name": "sripaa-growth-system-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Production REST API for SriPAA Growth System",
    "type": "module",
    "scripts": {
        "dev": "nodemon --exec tsx src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/server.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:seed:demo": "tsx prisma/seed-demo.ts",
        "db:reset": "prisma migrate reset",
        "db:generate": "prisma generate"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "6.12.0",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "pino": "^9.9.0",
        "pino-http": "^10.5.0",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.4.0",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.44.0",
        "@typescript-eslint/parser": "^8.44.0",
        "eslint": "^9.35.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.6.2",
        "prisma": "6.12.0",
        "supertest": "^7.1.4",
        "tsx": "^4.20.5",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1"
    },
    "overrides": {
        "minimatch": "^11.0.1"
    },
    "engines": {
        "node": ">=24.21.0",
        "npm": ">=12.1.0"
    }
}
